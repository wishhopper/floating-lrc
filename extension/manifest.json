{
  "manifest_version": 3,
  "name": "Floating lrc",
  "version": "1.0.0",
  "description": "Synced lyrics for YouTube Music as an always-on-top floating window or a transparent desktop overlay (lyrics from LRCLIB).",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lrclib.net/*",
    "http://127.0.0.1:38917/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "lrc.js",
        "adapters/youtube-music.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Floating lrc",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}